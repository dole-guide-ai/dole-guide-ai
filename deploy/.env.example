# 운영 서버 전용입니다. 서버의 /opt/dole-guide-ai/.env 로 복사해서 채웁니다. 이 파일에 실제 값을 넣어 커밋하지 마세요.

# DuckDNS 등에서 받은 백엔드 도메인 (https:// 없이)
DOMAIN=

# DB 계정. 비밀번호는 특수문자 없이 길게(주소에 들어가므로): openssl rand -hex 24
POSTGRES_USER=dole
POSTGRES_PASSWORD=
POSTGRES_DB=dole

# production이면 아래 LLM 값 3개가 비어 있을 때 서버가 시작되지 않습니다.
APP_ENV=production
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
AGENT_MODEL=
EXTRACT_MODEL=

# 백엔드를 부를 수 있는 프론트 주소 (JSON 배열)
CORS_ORIGINS=["https://dole-guide-ai.vercel.app"]
# Vercel 미리보기처럼 주소가 바뀌는 경우 정규식으로 허용 (비우면 사용 안 함)
CORS_ORIGIN_REGEX=^https://dole-guide-[a-z0-9]+-arthurjos-projects\.vercel\.app$
