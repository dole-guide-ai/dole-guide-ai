# 운영 서버 전용입니다. 서버의 /opt/dole-guide-ai/.env 로 복사해서 채웁니다. 이 파일에 실제 값을 넣어 커밋하지 마세요.

# DuckDNS 등에서 받은 백엔드 도메인 (https:// 없이)
DOMAIN=

# DB 계정. 비밀번호는 특수문자 없이 길게(주소에 들어가므로): openssl rand -hex 24
POSTGRES_USER=dole
POSTGRES_PASSWORD=
POSTGRES_DB=dole

# production이면 고른 공급자의 키와 AGENT_MODEL·EXTRACT_MODEL이 비어 있을 때 서버가 시작되지 않습니다.
APP_ENV=production
OPENAI_API_KEY=
UPSTAGE_API_KEY=
AGENT_PROVIDER=openai
AGENT_MODEL=
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=
# 평가(골든셋) 전용. 서버는 쓰지 않으니 비워 둬도 됩니다.
JUDGE_PROVIDER=
JUDGE_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
EMBEDDING_QUERY_MODEL=

# BFF 공유 비밀: Vercel의 BACKEND_INTERNAL_SECRET과 같은 값. 만들기: openssl rand -hex 32
INTERNAL_API_SECRET=
# 계좌 암호화 키 (Fernet). 만들기: docker compose run --rm backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_ENCRYPTION_KEY=
WORK24_API_KEY=
# 고용24 OpenAPI 대기 시간(초)과 재시도 횟수
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_API_RETRIES=1
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dole-guide-ai
# 계정 지역 API 주소. 비우면 US. APAC: https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=
LANGSMITH_TRACING=false
# 지금은 합성 데이터만 쓰므로 원문을 남겨 디버깅합니다.
# 실서비스(실제 개인정보) 전에는 true로 바꿉니다(설계 D6).
LANGSMITH_HIDE_IO=false
VISITOR_TTL_DAYS=7
MAX_UPLOAD_MB=4
TURN_TIMEOUT_SECONDS=180
LLM_TIMEOUT_SECONDS=60
# 규칙 카드 전달 방식: tool(모델이 찾음) | inject(미리 붙임)
RULE_CARDS_MODE=inject
RETRIEVAL_SYNONYMS=true
RETRIEVAL_MIN_SIMILARITY=0.50
RETRIEVAL_INJECT_LIMIT=5
RETRIEVAL_GUIDE_LIMIT=2
RETRIEVAL_REWRITE=false
RETRIEVAL_RERANK=true
RETRIEVAL_RERANK_CANDIDATES=20
ANSWER_CHECK=true
# 첨부 사진 처리: off · vision(사진째 모델에) · transcribe(글자만 받아써 가림)
IMAGE_MODE=vision
# 음성 인식 모델(OpenAI). 비우면 말하기 버튼이 동작하지 않음
STT_MODEL=
# 계정마다 1분에 음성 인식 호출 수 (넘으면 429)
STT_RATE_LIMIT_PER_MINUTE=10
IDEMPOTENCY_TTL_HOURS=24

# 백엔드를 부를 수 있는 프론트 주소 (JSON 배열)
CORS_ORIGINS=["https://dole-guide-ai.vercel.app"]
# Vercel 미리보기처럼 주소가 바뀌는 경우 정규식으로 허용 (비우면 사용 안 함)
# 미리보기 주소: dole-guide-<해시>-<팀>.vercel.app(배포별, 이름이 잘림), dole-guide-ai-git-<브랜치>-<팀>.vercel.app(브랜치별)
CORS_ORIGIN_REGEX=^https://dole-guide-[a-z0-9-]+-arthurjos-projects\.vercel\.app$
