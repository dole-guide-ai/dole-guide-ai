APP_ENV=local
DATABASE_URL=postgresql+psycopg://dole:dole@localhost:5432/dole
TEST_DATABASE_URL=postgresql+psycopg://dole:dole@localhost:5432/dole_test
OPENAI_API_KEY=
UPSTAGE_API_KEY=
AGENT_PROVIDER=openai
AGENT_MODEL=
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=
JUDGE_PROVIDER=
JUDGE_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
EMBEDDING_QUERY_MODEL=
INTERNAL_API_SECRET=
ACCOUNT_ENCRYPTION_KEY=
# 고용24 OpenAPI 인증키는 API마다 따로 발급됩니다(훈련과정 310L01 · 취업역량 프로그램 217L01 · 공통코드 21L01).
WORK24_TRAINING_API_KEY=
WORK24_PROGRAM_API_KEY=
WORK24_CODE_API_KEY=
# 예전 공용 키. 위 키가 비었을 때만 씁니다.
WORK24_API_KEY=
# 고용24 OpenAPI 대기 시간(초)과 재시도 횟수
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_API_RETRIES=1
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dole-guide-ai
LANGSMITH_ENDPOINT=
LANGSMITH_TRACING=false
LANGSMITH_HIDE_IO=false
VISITOR_TTL_DAYS=7
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=4
TURN_TIMEOUT_SECONDS=180
LLM_TIMEOUT_SECONDS=40
# 규칙 카드 전달 방식: tool(모델이 찾음) | inject(미리 붙임)
RULE_CARDS_MODE=inject
RETRIEVAL_SYNONYMS=true
RETRIEVAL_MIN_SIMILARITY=0.50
RETRIEVAL_INJECT_LIMIT=5
RETRIEVAL_GUIDE_LIMIT=2
RETRIEVAL_REWRITE=false
RETRIEVAL_RERANK=true
RETRIEVAL_RERANK_CANDIDATES=20
ANSWER_CHECK=true
# 첨부 사진 처리: off · vision(사진째 모델에) · transcribe(글자만 받아써 가림)
IMAGE_MODE=vision
# 음성 인식 모델(OpenAI). 비우면 말하기 버튼이 동작하지 않음
STT_MODEL=
# 계정마다 1분에 음성 인식 호출 수 (넘으면 429)
STT_RATE_LIMIT_PER_MINUTE=10
IDEMPOTENCY_TTL_HOURS=24
