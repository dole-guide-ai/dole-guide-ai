OPENAI_API_KEY=
UPSTAGE_API_KEY=
AGENT_PROVIDER=openai
AGENT_MODEL=
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=
JUDGE_PROVIDER=
JUDGE_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=
EMBEDDING_QUERY_MODEL=
INTERNAL_API_SECRET=
ACCOUNT_ENCRYPTION_KEY=
# 고용24 OpenAPI 인증키 (API마다 따로 발급): 공통코드(스크립트 전용) · 훈련과정 · 취업역량 프로그램
WORK24_CODE_API_KEY=
WORK24_TRAINING_API_KEY=
WORK24_PROGRAM_API_KEY=
# 고용24 OpenAPI 대기 시간(초)과 재시도 횟수
