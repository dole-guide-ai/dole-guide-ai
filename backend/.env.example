LANGSMITH_HIDE_IO=false
VISITOR_TTL_DAYS=7
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=4
TURN_TIMEOUT_SECONDS=180
LLM_TIMEOUT_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24
