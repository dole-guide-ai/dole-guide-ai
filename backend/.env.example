# backend/.env 로 복사해서 씁니다. (pnpm bootstrap이 자동으로 복사)
APP_ENV=local
DATABASE_URL=postgresql+psycopg://dole:dole@localhost:5432/dole
TEST_DATABASE_URL=postgresql+psycopg://dole:dole@localhost:5432/dole_test

# LLM (local에서는 비어 있어도 서버가 뜨고, 시작할 때 경고만 합니다)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
AGENT_MODEL=
EXTRACT_MODEL=
# 골든셋 LLM 판정 모델 (비우면 AGENT_MODEL)
JUDGE_MODEL=

# BFF(Next)와 같은 값. local에서 비우면 확인하지 않습니다.
INTERNAL_API_SECRET=
# 계좌 암호화 키. 만들기: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# local에서 비우면 개발용 키를 씁니다(운영 금지).
ACCOUNT_ENCRYPTION_KEY=
# 고용24 OpenAPI 인증키 (비우면 스냅샷만 씀)
WORK24_API_KEY=
# LangSmith (비우면 트레이스 끔)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dole-guide-ai
LANGSMITH_TRACING=false

VISITOR_TTL_DAYS=7
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=4
TURN_TIMEOUT_SECONDS=180
